# From the BuildBase console (https://console.buildbase.app). See README.

# API server - leave as is unless you self-host BuildBase
NEXT_PUBLIC_BUILDBASE_SERVER_URL=https://api.console.buildbase.app
# Settings -> General -> Organization ID
NEXT_PUBLIC_BUILDBASE_ORG_ID=
# User Management -> Authentication -> your client
NEXT_PUBLIC_BUILDBASE_CLIENT_ID=
BUILDBASE_CLIENT_SECRET=
# Register this exact URL on the client. Locally: http://localhost:3000/dream
NEXT_PUBLIC_BUILDBASE_REDIRECT_URL=http://localhost:3000/dream

# Optional. Without it the app runs in demo mode: credits are spent, but the
# result is a sample image. https://replicate.com/account/api-tokens
REPLICATE_API_KEY=
# Optional. Bytescale key for uploads; "free" is used when empty.
NEXT_PUBLIC_UPLOAD_API_KEY=
