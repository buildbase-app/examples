# From the BuildBase console (https://console.buildbase.app). See README.
# Copy to .env.local, which is not committed.

# API server - leave as is unless you self-host BuildBase
VITE_BUILDBASE_SERVER_URL=https://api.console.buildbase.app
# Settings -> General -> Organization ID
VITE_BUILDBASE_ORG_ID=
# User Management -> Authentication -> your client
VITE_BUILDBASE_CLIENT_ID=
# Register this exact URL on the client. Locally: http://localhost:5173/sign-in
VITE_BUILDBASE_REDIRECT_URL=http://localhost:5173/sign-in
# Server only: read by api/auth (Vercel) and the Vite dev server, never bundled
BUILDBASE_CLIENT_SECRET=
