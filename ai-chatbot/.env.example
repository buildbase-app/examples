# ── BuildBase: sign-in, workspaces and credits ─────────────────────────────
# From the BuildBase console (https://console.buildbase.app). See README.

# API server - leave as is unless you self-host BuildBase
NEXT_PUBLIC_BUILDBASE_SERVER_URL=https://api.console.buildbase.app
# Settings -> General -> Organization ID
NEXT_PUBLIC_BUILDBASE_ORG_ID=****
# User Management -> Authentication -> your client
NEXT_PUBLIC_BUILDBASE_CLIENT_ID=****
BUILDBASE_CLIENT_SECRET=****
# Where the hosted sign-in page sends people back. Register this exact URL on
# the client. Locally: http://localhost:3000/welcome
NEXT_PUBLIC_BUILDBASE_REDIRECT_URL=http://localhost:3000/welcome

# ── From the upstream template ─────────────────────────────────────────────
# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****
