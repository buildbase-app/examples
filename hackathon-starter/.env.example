#
# The App ID, Keys, or Secrets in this file are placeholders.
# You would need to register with API providers that tour application needs and use your own keys.
# You can override the values using environment variables if you wish. Some developers prefer that
# to avoid accidental check-in of credentials to code repos.
#
# Changed for the BuildBase example: upstream fills in shared demo credentials
# for the third-party API pages. They are placeholders here; add your own test keys.
# (i.e. enter the following in console: "export SMTP_PASSWORD=blah_blah_blah" )
# Most hosting providers provide means to set environment variables as well.
#
BASE_URL=http://localhost:8080
MONGODB_URI=mongodb://localhost:27017/test
SITE_CONTACT_EMAIL=youremail@yourdomain.com
TRANSACTION_EMAIL=youremail-OR-noreply@yourdomain.com

SESSION_SECRET=Your Session Secret goes here

# BuildBase: sign-in, workspaces and credits (https://console.buildbase.app).
# Sign-in stays disabled until these three are set. See README.
# Register $BASE_URL/auth/buildbase/callback as a redirect URL on the client.
BUILDBASE_SERVER_URL=https://api.console.buildbase.app
BUILDBASE_ORG_ID=
BUILDBASE_CLIENT_ID=
BUILDBASE_CLIENT_SECRET=

SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_HOST=your.smtp.host.com

#
# API KEYS
#
ALPHA_VANTAGE_KEY=alpha-vantage-api-key

DISCORD_CLIENT_ID=discord-client-id/discord-app-id
DISCORD_CLIENT_SECRET=discord-client-secret

FACEBOOK_ID=your-facebook-id
FACEBOOK_SECRET=your-facebook-secret
# FB Pixel ID is optional if you are trying to do customer rtracking
FACEBOOK_PIXEL_ID=

FOURSQUARE_APIKEY=foursquare-service-key

GIPHY_API_KEY=your-giphy-api-key

GITHUB_ID=your-github-id
GITHUB_SECRET=your-github-secret

# Google Analytics is optional if you are trying to do customer rtracking
GOOGLE_ANALYTICS_ID=

# Google credentials for OAuth, APIs such as Gogole Docs, Google Sheets, etc.
GOOGLE_PROJECT_ID=hackathon-starter-xxxxxx
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MAP_API_KEY=google-map-api-key
GOOGLE_RECAPTCHA_SITE_KEY=

GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION=qwen/qwen3.6-27b
GROQ_MODEL_PROMPT_GUARD=openai/gpt-oss-safeguard-20b

HERE_API_KEY=9bxxxxxxxxxxxxxxxxJFHg

HUGGINGFACE_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HUGGINGFACE_PROVIDER=hf-inference

LASTFM_KEY=your-lastfm-key
LASTFM_SECRET=your-lastfm-secret

LINKEDIN_ID=your-linkedin-id
LINKEDIN_SECRET=your-linkedin-secret

MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

LOB_KEY=your-lob-key

NYT_KEY=your-nyt-key

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

PAYPAL_ID=your-paypal-id
PAYPAL_SECRET=your-paypal-secret

