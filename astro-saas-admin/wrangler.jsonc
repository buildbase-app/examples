{
  "name": "saas-admin-template",
  "main": "./dist/index.js",
  "assets": {
    "directory": "./dist"
  },
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  // Changed for the BuildBase example: the org, the auth client and the admin
  // workspace. Put BUILDBASE_CLIENT_SECRET (and API_TOKEN, for machine clients)
  // in with `wrangler secret put`. Locally, .dev.vars overrides these.
  "vars": {
    "EXAMPLE_VALUE": "example_value",
    "BUILDBASE_SERVER_URL": "https://api.console.buildbase.app",
    "BUILDBASE_ORG_ID": "",
    "BUILDBASE_CLIENT_ID": "",
    "ADMIN_WORKSPACE_ID": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "admin-db",
      "database_id": "3009feae-2321-421c-97e8-181886710aa0"
    }
  ],
  "workflows": [
    {
      "name": "saas-admin-template-customer-workflow",
      "binding": "CUSTOMER_WORKFLOW",
      "class_name": "CustomerWorkflow"
    }
  ]
}
