# From your BuildBase console. See the README for the steps.
# An org API token with the content-reader role: <orgId>:<secret>
BUILDBASE_API_TOKEN=
# The signing secret of the webhook endpoint you register for /webhooks/buildbase
BUILDBASE_WEBHOOK_SECRET=

# Optional
# BUILDBASE_SERVER_URL=https://api.console.buildbase.app
# FAQ_COLLECTION=demo-help
# RICH_CONTENT=refund-policy
# CHANGELOG_COLLECTION=release-notes
# PORT=3000
